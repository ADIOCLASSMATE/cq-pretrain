        "partial-1117/bb22-dit26",
        "partial-1117/bb24-dit22",
        "partial-1117/bb24-dit26"
      ],
      "b63cc9e882de4cc8-": [
        "partial-1117/bb22-dit30",
        "prod-1117/recompute-bb",
        "prod-1117/recompute-full"
      ]
    },
    "retracted": [
      "partial recompute bb18/dit30 = +11.5% (ran with partially fused norms)",
      "partial recompute bb24/dit22 = +25.0% (ran with fully fused norms)",
      "partial recompute bb24/dit26 = +24.9% (ran with fully fused norms)"
